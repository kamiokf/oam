{
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*"
        ],
        "headers": [
            {
                "source": "**/*.@(ttf|otf|woff|woff2)",
                "headers": [
                    {
                        "key": "Access-Control-Allow-Origin",
                        "value": "*"
                    }
                ]
            },
            {
                "source": "**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "**/*.@(js|css|ttf|otf|woff|woff2|png|jpg|jpeg|gif|svg)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}